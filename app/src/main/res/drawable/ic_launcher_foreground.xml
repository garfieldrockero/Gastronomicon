<?xml version="1.0" encoding="utf-8"?>
<!-- Primer plano del icono: un recetario cerrado con tenedor y cuchara en la tapa.
     Todo cabe en la zona segura de 66 dp (círculo de radio 33 centrado en 54,54), así
     que ninguna máscara del lanzador recorta el dibujo. Colores de la paleta provisional
     de ui/theme/Theme.kt: si la paleta cambia, hay que cambiarlos aquí también. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Reducido un 8 % para que el libro no roce el borde de la máscara redonda. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.92"
        android:scaleY="0.92">

        <!-- Cantos de las hojas, que asoman por la derecha y por abajo. -->
        <path
            android:fillColor="#FFFAF2"
            android:pathData="M38,30H74a2,2 0,0 1,2 2V78a2,2 0,0 1,-2 2H38Z" />
        <path
            android:strokeColor="#D8C2A3"
            android:strokeWidth="0.8"
            android:pathData="M40,78.6H74.6V32" />

        <!-- Cinta marcapáginas. -->
        <path
            android:fillColor="#5F6B3B"
            android:pathData="M63,76h4v8l-2,-2l-2,2Z" />

        <!-- Tapa y lomo. -->
        <path
            android:fillColor="#9C4A2F"
            android:pathData="M36,28H71a2,2 0,0 1,2 2V75a2,2 0,0 1,-2 2H36a4,4 0,0 1,-4 -4V32a4,4 0,0 1,4 -4Z" />
        <path
            android:fillColor="#7A3622"
            android:pathData="M36,28h2v49h-2a4,4 0,0 1,-4 -4V32a4,4 0,0 1,4 -4Z" />

        <!-- Tenedor. -->
        <path
            android:fillColor="#F3E6D3"
            android:pathData="M44.5,34h2v9h1.5v-9h2v9h1.5v-9h2v10q0,4 -3,5v20.5a1.5,1.5 0,0 1,-3 0V49q-3,-1 -3,-5Z" />

        <!-- Cuchara: cazo y mango en un solo contorno. -->
        <path
            android:fillColor="#F3E6D3"
            android:pathData="M60.5,46.63A4.5,6.5 0,1 1,63.5 46.63V69.5a1.5,1.5 0,0 1,-3 0Z" />
    </group>
</vector>
