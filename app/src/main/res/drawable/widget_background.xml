<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo del widget: papel del tema con una línea suave, como las tarjetas de
     la app. El color cambia solo en modo oscuro (values-night). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_background_color" />
    <corners android:radius="16dp" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_outline" />
</shape>
