<?xml version="1.0" encoding="utf-8"?>
<!-- Solo HTTPS y solo los certificados del sistema. Sin excepciones para HTTP en
     claro ni para certificados autofirmados: el servidor usa Let's Encrypt. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
