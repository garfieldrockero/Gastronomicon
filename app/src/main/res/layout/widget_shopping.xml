<?xml version="1.0" encoding="utf-8"?>
<!-- Layout del widget de la compra. Solo vistas del framework (RemoteViews): el
     launcher lo infla con los recursos de la app, así que los colores y los
     tamaños van explícitos y el modo oscuro se resuelve con values-night.
     Ocho filas fijas (el máximo del núcleo); el renderizador oculta las que no
     caben y las que no hay. Cada fila es un objetivo táctil de 48 dp con su
     descripción para TalkBack y una casilla vacía decorativa (lo que queda por
     comprar, no lo ya hecho).

     ALTURAS: esto y `core/widget/ShoppingWidgetLayout.kt` van de la mano. El
     núcleo reserva CHROME_DP = 140 dp para todo lo que no es fila —relleno 20 +
     cabecera 48 + «y N más» 18 + hora 18 + línea de estado 36— y
     ROW_HEIGHT_DP = 48 dp por fila. Con una fila hacen falta 188 dp, así que
     `minResizeHeight` de xml/widget_shopping_info.xml son 190 dp. Si aquí se
     cambia un alto, un relleno o un textSize, hay que cambiar el núcleo y la
     ficha o el pie se recorta por abajo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Cabecera: pulsarla abre la pestaña Compra. La descripción para TalkBack
         incluye el nombre y los contadores, y los hijos quedan decorativos. -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_touch"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="2dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:importantForAccessibility="no"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Dos líneas: «Faltan 3 cosas · 2 en el carro» no cabe en una con
                 el texto del sistema grande. -->
            <TextView
                android:id="@+id/widget_counts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:importantForAccessibility="no"
                android:maxLines="2"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/widget_refresh"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/widget_touch"
            android:contentDescription="@string/widget_refresh"
            android:src="@drawable/ic_refresh"
            android:tint="@color/widget_accent" />
    </LinearLayout>

    <!-- Fila 1 -->
    <LinearLayout
        android:id="@+id/widget_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_touch"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="2dp"
            android:src="@drawable/widget_checkbox" />

        <TextView
            android:id="@+id/widget_row_text_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="2"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Fila 2 -->
    <LinearLayout
        android:id="@+id/widget_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_touch"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="2dp"
            android:src="@drawable/widget_checkbox" />

        <TextView
            android:id="@+id/widget_row_text_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="2"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Fila 3 -->
    <LinearLayout
        android:id="@+id/widget_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_touch"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="2dp"
            android:src="@drawable/widget_checkbox" />

        <TextView
            android:id="@+id/widget_row_text_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="2"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Fila 4 -->
    <LinearLayout
        android:id="@+id/widget_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_touch"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="2dp"
            android:src="@drawable/widget_checkbox" />

        <TextView
            android:id="@+id/widget_row_text_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="2"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Fila 5 -->
    <LinearLayout
        android:id="@+id/widget_row_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_touch"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="2dp"
            android:src="@drawable/widget_checkbox" />

        <TextView
            android:id="@+id/widget_row_text_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="2"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Fila 6 -->
    <LinearLayout
        android:id="@+id/widget_row_6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_touch"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="2dp"
            android:src="@drawable/widget_checkbox" />

        <TextView
            android:id="@+id/widget_row_text_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="2"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Fila 7 -->
    <LinearLayout
        android:id="@+id/widget_row_7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_touch"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="2dp"
            android:src="@drawable/widget_checkbox" />

        <TextView
            android:id="@+id/widget_row_text_7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="2"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Fila 8 -->
    <LinearLayout
        android:id="@+id/widget_row_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_touch"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="2dp"
            android:src="@drawable/widget_checkbox" />

        <TextView
            android:id="@+id/widget_row_text_8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:importantForAccessibility="no"
            android:maxLines="2"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- «y N más»: pendientes que no caben en las filas visibles. Va DEBAJO de
         la última fila: ahí se lee como un resumen de lo que sigue, no como un
         título de la lista. -->
    <TextView
        android:id="@+id/widget_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp" />

    <!-- Estado vacío: primera vez, sin sesión, lista vacía o almacén sin
         responder. Todo el bloque abre la app y no repite la pista: el título
         ya dice qué hacer. -->
    <LinearLayout
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_touch"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/widget_empty_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:maxLines="3"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Línea de estado fija («Guardando…», errores, «En el carro: …»). Es una
         región viva para que el launcher pueda anunciarla. Tres líneas para que
         la frase larga no se corte con el texto del sistema grande; el núcleo
         reserva sitio para dos. -->
    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:ellipsize="end"
        android:maxLines="3"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:textColor="@color/widget_accent"
        android:textSize="13sp" />

    <!-- Hora de la copia: absoluta, así no hace falta repintar cada minuto. -->
    <TextView
        android:id="@+id/widget_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:textColor="@color/widget_text_secondary"
        android:textSize="13sp" />
</LinearLayout>
