<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Recordatorio del planificador: se pide al activarlo en Ajustes (nunca al
         instalar) y RECEIVE_BOOT_COMPLETED solo reprograma la alarma, sin red ni
         datos. No se pide SCHEDULE_EXACT_ALARM ni WAKE_LOCK. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/extraccion_datos"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/seguridad_red"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gastronomicon">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Recordatorio local del planificador. No exportado: solo el sistema puede
          entregarle difusiones (el sistema puede aunque no esté exportado), y la
          acción de la alarma NO está aquí: viaja en el PendingIntent explícito.
          Solo reprograma en reinicio, actualización o cambio de hora; el aviso
          diario sale de la alarma, sin red y sin leer la sesión.
        -->
        <receiver
            android:name=".platform.ReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
          Para hacer la foto con la cámara del sistema (TakePicture) sin permiso CAMERA:
          la app de cámara escribe en un fichero de nuestra caché y le damos permiso
          temporal solo para ese Uri. No exportado y sin permisos de almacenamiento.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.camara"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/rutas_camara" />
        </provider>
    </application>
</manifest>
